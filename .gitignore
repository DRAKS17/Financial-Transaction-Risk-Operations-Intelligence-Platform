# Virtual Environment
.venv/
env/
venv/
ENV/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables & secrets
.env
.env.local
*.pem
*.key

# Data directories (do not commit raw transaction data or large processed files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Operating system artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and Editor configs (keep local)
.vscode/
.idea/

# Database dumps / temp files
*.sqlite3
*.dump
*.sql.bak
