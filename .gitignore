# Virtual Environment
.venv/
env/
venv/
ENV/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables & secrets
.env
.env.local
*.pem
*.key

# Data directories (do not commit large raw transaction datasets or large processed CSVs)
data/raw/*.csv
data/raw/*.tmp
data/raw/*.zip
data/raw/*.parquet
data/processed/*.csv
data/processed/*.parquet
data/external/*.csv

# Operating system artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and Editor configs (keep local)
.vscode/
.idea/

# Database dumps / temp files
*.sqlite3
*.dump
*.sql.bak
